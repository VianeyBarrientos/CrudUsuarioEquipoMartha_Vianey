@model ML.Usuario
@{
    ViewBag.Title = "GetAll";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://icons.getbootstrap.com/icons/search/" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

<div class="container">
    <div class="row">
        <div class="col-4">
            @Html.ActionLink("+", "Formulario", "Usuario", new {IdUsuario = 0, @class = "btn btn-success" })
        </div>
    </div>
</div>


<table class="table">
    <div class="row">
        <div class="col-md-6">
            @if (Model.Usuarios != null)
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Actualizar</th>
                            <th>IdUsuario</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>FechaNacimiento</th>
                            <th>Eliminar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ML.Usuario usuario in Model.Usuarios)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("Formulario", "Usuario", new {IdUsuario = usuario.IdUsuario})">Actualizar</a>
                                </td>
                                <td>@usuario.IdUsuario</td>
                                <td>@usuario.Nombre</td>
                                <td>@usuario.Apellido</td>
                                <td>@usuario.FechaNacimiento</td>
                                <td>
                                    <a href="@Url.Action("Delete", new {IdUsuario = usuario.IdUsuario})">
                                        <i class="bi bi-trash"></i>

                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class=" alert alert-danger" role="alert">
                    A simple danger alert-check it out!
                </div>
            }
        </div>
    </div>

</table>
@*<h2>GetAll</h2>*@

